# How bezzle.ch serves the site: One.com's Apache, behind its Varnish cache. Goes up with the rest of
# dist/ (scripts/upload.sh puts it first). Everything here is for that server alone: a directive it
# does not know would take the whole site down, so each module's own lines wait for the module.

# The types GitHub Pages gave and Apache may not know: modules are only run when served as
# JavaScript, WebAssembly only streamed when served as such.
AddType text/javascript .js .mjs
AddType application/wasm .wasm
AddType image/webp .webp
AddType image/avif .avif
AddType font/ttf .ttf
AddType font/woff2 .woff2
# The docs as Markdown, llms.txt and robots.txt, the web app manifest and the icon.
AddType text/markdown .md
AddType text/plain .txt
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
AddCharset utf-8 .html .js .mjs .css .json .xml .txt .md .webmanifest

# The browser version unpacks its gzipped WebAssembly itself (app/index.html): those files go out as
# the bytes they are, never as an answer the browser would unpack first.
RemoveEncoding .gz
<FilesMatch "\.gz$">
    ForceType application/gzip
</FilesMatch>

# The missing page, in the language of the address.
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/de/#">
    ErrorDocument 404 /de/404.html
</If>
<ElseIf "%{REQUEST_URI} =~ m#^/fr/#">
    ErrorDocument 404 /fr/404.html
</ElseIf>
<ElseIf "%{REQUEST_URI} =~ m#^/it/#">
    ErrorDocument 404 /it/404.html
</ElseIf>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    # One address: always HTTPS (as One.com's guide has it), and www goes to the bare domain.
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.bezzle\.ch$ [NC]
    RewriteRule ^ https://bezzle.ch%{REQUEST_URI} [R=301,L]
    # A page without its .html (/download, /admin) is sent on to its address with it, for good: the app
    # knows its pages by that address, and would show the missing page in place of one it does not
    # recognize, and search engines keep one address per page.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ /$1.html [R=301,L]
</IfModule>

# The list of what is on the server, kept by scripts/upload.sh, is nobody's to read.
<Files ".htdeploy">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</Files>

<IfModule mod_headers.c>
    # Pages, the update feed and the browser version change in place: asked again every time, so a
    # deploy shows at once (Varnish keeps nothing marked no-cache). The built scripts and styles,
    # named after their content, are kept for good; the pictures for a day.
    Header set Cache-Control "no-cache"
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <ElseIf "%{REQUEST_URI} =~ m#^/img/#">
        Header set Cache-Control "public, max-age=86400"
    </ElseIf>
    # Not for search results: the browser version (a shared design's address carries its secret
    # after the #), the update feed, and the text files for crawlers and assistants (robots.txt,
    # llms.txt, llms-full.txt, the IndexNow key), whose words are on the pages themselves.
    <If "%{REQUEST_URI} =~ m#^/(app|updates)/# || %{REQUEST_URI} =~ m#\.txt$#">
        Header set X-Robots-Tag "noindex"
    </If>
</IfModule>

# A docs page as Markdown (docs/shapes.md) names its page as the one to keep (docs/shapes.html).
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^(/.+)\.md$" BZ_PAGE=$1
</IfModule>
<IfModule mod_headers.c>
    Header set Link "<https://bezzle.ch%{BZ_PAGE}e.html>; rel=\"canonical\"" env=BZ_PAGE
</IfModule>

<IfModule mod_filter.c>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml font/ttf text/markdown text/plain
    </IfModule>
</IfModule>
